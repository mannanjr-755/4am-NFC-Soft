# 4AM dashboard — Neon PostgreSQL
# Dashboard and Digital Menu share the same database so kitchen orders
# from the menu appear on this dashboard.
# Omit channel_binding=require — Prisma Postgres connector does not support it.
# Raise connect_timeout / pool_timeout above Prisma's 10s defaults for Neon TLS.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30"

# Generate with: npx auth secret
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST="true"
# PIN required to open Reports in the dashboard (default 1234 if unset)
REPORTS_PIN="1234"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# Deployed Digital Menu URL
NEXT_PUBLIC_SITE_URL="https://4amdigitalmenu.vercel.app"
